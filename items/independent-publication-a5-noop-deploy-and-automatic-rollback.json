      {
        "dont": "Disable the old deploy before a production no-op and rollback drill",
        "instead": "retain it until both gates pass",
        "item_id": "independent-publication-a5-noop-deploy-and-automatic-rollback",
        "why": "there would be no proven recovery path"
      },
      {
        "dont": "Release the promotion lock after upload but before verification",
        "instead": "hold the lock through verify or verified rollback",
        "item_id": "independent-publication-a5-noop-deploy-and-automatic-rollback",
        "why": "a failed deployment can race with later promotions"
      }
