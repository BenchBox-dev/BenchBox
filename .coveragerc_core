[run]
parallel = true
omit =
    */tests/*
    */__pycache__/*
    conftest.py
    benchbox/__main__.py
    **/test_*.py
    **/conftest.py
    benchmark_runs/*
    # generated/templated per-query DataFrame implementations; verified via golden-output cross-platform comparison tests (tests/integration/validation, test_dask_dataframe_integration.py), not line coverage
    benchbox/core/tpcds/dataframe_queries/queries.py
    # ROLLUP/GROUP BY expansion helper for TPC-DS DataFrame queries; covered by tests/unit/core/tpcds/test_rollup_helper.py, deliberately excluded from the line-coverage gate
    benchbox/core/tpcds/dataframe_queries/rollup_helper.py
    # multi-channel (store/catalog/web) union helper for TPC-DS DataFrame queries; covered by tests/unit/core/tpcds/test_channel_helper.py, deliberately excluded from the line-coverage gate
    benchbox/core/tpcds/dataframe_queries/channel_helper.py
    # generated/templated per-query DataFrame implementations; verified via golden-output tests (tests/unit/core/datavault/test_datavault_dataframe_queries.py), not line coverage
    benchbox/core/datavault/dataframe_queries/queries.py
    # generated/templated per-query DataFrame implementations; verified via golden-output tests (tests/unit/core/nyctaxi/test_nyctaxi_dataframe_queries.py), not line coverage
    benchbox/core/nyctaxi/dataframe_queries/queries.py
    # experimental load-test executor; not imported by any production/release-gate code path
    benchbox/experimental/concurrency/executor.py
    # experimental connection-pool tester; not imported by any production/release-gate code path
    benchbox/experimental/concurrency/pool_tester.py
    # generated/templated per-query DataFrame implementations; verified via golden-output tests (tests/unit/core/clickbench/test_clickbench_dataframe_queries.py), not line coverage
    benchbox/core/clickbench/dataframe_queries/queries.py

[report]
show_missing = True
skip_empty = False
