# Fallback for BENCHBOX_DATA_DIR when it is not exported before running
# `docker compose` in this directory (bare, no -f override). Resolved
# relative to THIS file's directory (docker/velox/), i.e.
# docker/velox/benchmark_runs -- matching the historical
# ${PWD}/benchmark_runs default for `cd docker/velox && docker compose up`.
#
# UAT (tests/uat/phases/execute.py) always exports an absolute
# BENCHBOX_DATA_DIR, which overrides this value on both docker compose and
# mocker. See docker-compose.yml for why the mount uses the flat ${VAR} form
# instead of a nested default or a ${VAR:?message} required-variable form,
# and why velox-runner (which has no data mount of its own) also needs this
# fallback present.
BENCHBOX_DATA_DIR=./benchmark_runs
