{
  "cases": [
    {
      "id": "local_embedded_duckdb",
      "platform": "DuckDB",
      "system_profile": {
        "os_type": "Linux",
        "os_release": "6.8",
        "architecture": "x86_64"
      },
      "execution_environment": {
        "platform_runtime": {
          "runtime_type": "local_process",
          "collection_status": "available",
          "source": "observed",
          "os": "Linux",
          "arch": "x86_64"
        }
      },
      "platform_deployment": {
        "deployment_type": "embedded",
        "connection_mode": "in-memory",
        "endpoint_class": "embedded_process",
        "metadata_source": "observed",
        "collection_status": "available"
      },
      "platform_raw_config": {
        "database": ":memory:",
        "threads": 4
      },
      "assertions": {
        "environment.client_host.os": "Linux 6.8",
        "environment.platform_runtime.runtime_type": "local_process",
        "platform.deployment.endpoint_class": "embedded_process",
        "platform.raw_config.database": ":memory:"
      }
    },
    {
      "id": "docker_localhost_clickhouse",
      "platform": "ClickHouse Server",
      "system_profile": {
        "os_type": "Darwin",
        "os_release": "24.4.0",
        "architecture": "arm64"
      },
      "execution_environment": {
        "platform_runtime": {
          "runtime_type": "docker_container",
          "collection_status": "available",
          "source": "observed",
          "os": "Linux",
          "arch": "amd64",
          "engine_host": "container:benchbox-clickhouse"
        },
        "container": {
          "collection_status": "available",
          "source": "observed",
          "docker_engine_version": "26.1.0",
          "image": "clickhouse/clickhouse-server:24.1",
          "image_digest": "sha256:fixturedigest",
          "container_id": "clickhouse-container-id",
          "container_name": "benchbox-clickhouse-fixture",
          "os": "linux",
          "arch": "amd64",
          "port_mappings": {
            "8123/tcp": [
              {
                "host_ip": "127.0.0.1",
                "host_port": "8123"
              }
            ]
          },
          "bind_mounts": [
            {
              "source": "/Users/benchbox/data/clickhouse",
              "destination": "/var/lib/clickhouse"
            }
          ]
        }
      },
      "platform_deployment": {
        "deployment_type": "self_hosted",
        "connection_mode": "localhost",
        "endpoint_class": "localhost_port",
        "metadata_source": "observed",
        "collection_status": "available"
      },
      "platform_raw_config": {
        "host": "localhost",
        "port": 8123
      },
      "platform_raw_metadata": {
        "server_version": "24.1"
      },
      "assertions": {
        "environment.client_host.os": "Darwin 24.4.0",
        "environment.platform_runtime.runtime_type": "docker_container",
        "environment.container.image": "clickhouse/clickhouse-server:24.1",
        "platform.deployment.endpoint_class": "localhost_port",
        "platform.raw_config.host": "localhost",
        "platform.raw_metadata.server_version": "24.1"
      },
      "public_export": {
        "absent": [
          "clickhouse-container-id",
          "benchbox-clickhouse-fixture",
          "/Users/benchbox/data/clickhouse",
          "/var/lib/clickhouse"
        ],
        "prefixes": {
          "environment.container.container_id": "container_",
          "environment.container.container_name": "container_",
          "environment.container.bind_mounts.0.source": "path_",
          "environment.container.bind_mounts.0.destination": "path_"
        }
      }
    },
