{
  "name": "benchbox-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "convert": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/converter/cli.ts",
    "inventory": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/myst-inventory.ts",
    "id-parity": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/id-parity.ts",
    "dev": "npm run convert && astro dev",
    "build": "npm run convert && astro build && node scripts/pagefind-index.mjs dist",
    "preview": "astro preview",
    "check": "BENCHBOX_ALLOW_EMPTY_SIDEBAR=1 astro check",
    "test": "vitest run",
    "audit:high": "node scripts/audit-high.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "verify": "node e2e/verify.mjs",
    "verify:shell": "node e2e/shell.mjs",
    "verify:not-found": "node e2e/not-found.mjs",
    "verify:landing": "node e2e/landing.mjs",
    "verify:explorer": "node e2e/explorer.mjs",
    "verify:parity": "node e2e/parity.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/preact": "6.0.5",
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "astro": "7.3.5",
    "mermaid": "12.1.0",
    "pagefind": "1.5.2",
    "preact": "10.29.8",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-smartypants": "3.0.3",
    "remark-stringify": "11.0.0",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "fast-xml-parser": "5.11.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
