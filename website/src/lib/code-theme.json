{
  "name": "benchbox-code",
  "type": "dark",
  "colors": {
    "editor.background": "#2e0b16",
    "editor.foreground": "#f2e1d4"
  },
  "tokenColors": [
    {
      "name": "Text",
      "scope": "source, text, variable, variable.other, variable.parameter, meta.definition.variable, entity.name.namespace, entity.name.type.module, support.other.namespace",
      "settings": {
        "foreground": "#f2e1d4"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a7c6ed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment.Preproc",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Comment.PreprocFile",
      "scope": [
        "meta.preprocessor.include string",
        "meta.preprocessor string"
      ],
      "settings": {
        "foreground": "#e8c9a0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword.Namespace",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.at-rule"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Keyword.Constant",
      "scope": [
        "constant.language",
        "support.constant.language"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Keyword.Pseudo",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Keyword.Type",
      "scope": [
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Operator.Word",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.word",
        "keyword.operator.expression",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e8c9a0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String.Doc",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#a7c6ed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String.Backtick",
      "scope": [
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String.Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String.Interpol",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression punctuation",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String.Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "String.Symbol",
      "scope": [
        "constant.other.symbol",
        "string.other.symbol"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Attribute",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "meta.property-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Builtin",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.class",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Builtin.Pseudo",
      "scope": [
        "variable.language.self",
        "variable.language.this",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Class",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Name.Constant",
      "scope": [
        "variable.other.constant",
        "constant.other",
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Decorator",
      "scope": [
        "meta.function.decorator",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "meta.decorator variable.other",
        "meta.decorator entity.name.function"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Exception",
      "scope": [
        "support.class.exception",
        "entity.name.exception",
        "entity.name.type.exception"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Name.Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function-call"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Function.Magic",
      "scope": [
        "support.function.magic",
        "support.variable.magic"
      ],
      "settings": {
        "foreground": "#b8e0d2",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Name.Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f4a988",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Generic.Deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffd58a",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Generic.Inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#e8c9a0",
        "fontStyle": "normal"
      }
    },
    {
      "name": "Generic.Heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#d7b8f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Generic.Emph",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Generic.Strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Generic.Underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f2e1d4",
        "fontStyle": "normal",
        "background": "#a3231f"
      }
    }
  ]
}
