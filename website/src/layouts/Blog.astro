---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { postPath, tagGroups, tagPath, yearGroups } from "../lib/blog.ts";
import { loadBlog } from "../lib/blog-posts.ts";
import { blogTrail } from "../lib/breadcrumbs.ts";
import Shell from "./Shell.astro";

export interface BlogLink {
  label: string;
  href: string;
}

export interface BlogSeries {
  title: string;
  currentHref: string;
  posts: BlogLink[];
}

export interface BlogHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  titleId?: string;
  description?: string;
  subtitle?: string;
  author?: string;
  date?: string;
  dateIso?: string;
  searchable?: boolean;
  authorHref?: string;
  tags?: BlogLink[];
  series?: BlogSeries;
  previous?: BlogLink;
  next?: BlogLink;
  headings?: BlogHeading[];
  isIndex: boolean;
}

const { title, titleId, description, subtitle, author, date, dateIso, searchable = true, authorHref, tags = [], series, previous, next, headings = [], isIndex } =
  Astro.props;
const hasMeta = Boolean(author || date || series);

const NAV_TAG_LIMIT = 18;
const here = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const isHere = (href: string) => here === href.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const posts = (await loadBlog()).published;
const years = [...yearGroups(posts)];
const currentPost = posts.find((post) => isHere(postPath(post)));
const openYear = currentPost ? String(currentPost.date.getUTCFullYear()) : years[0]?.[0];
const allTags = [...tagGroups(posts)];
const navTags = [...allTags]
  .sort(([a, aPosts], [b, bPosts]) => bPosts.length - aPosts.length || (a < b ? -1 : a > b ? 1 : 0))
  .slice(0, NAV_TAG_LIMIT)
  .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Shell
  title={`${title} - BenchBox Blog`}
  description={description ?? (isIndex ? "BenchBox blog: release notes, benchmark deep dives and platform comparisons." : `${title} - BenchBox blog post.`)}
  type={isIndex ? "website" : "article"}
  searchable={searchable}
>
  <Breadcrumbs slot="context" crumbs={blogTrail(title, isIndex)} />
  <div class="blog-layout">
    <nav class="blog-nav" aria-label="Blog" data-pagefind-ignore>
      <ul class="blog-nav__list">
        <li><a href="/blog/" aria-current={isIndex ? "page" : undefined}>All posts</a></li>
        <li><a href="/blog/archive.html" aria-current={isHere("/blog/archive.html") ? "page" : undefined}>Archive</a></li>
      </ul>
      {
        years.map(([year, yearPosts]) => (
          <details class="blog-nav__year" open={year === openYear}>
            <summary class="blog-nav__group">{year}</summary>
            <ul class="blog-nav__list">
              {yearPosts.map((post) => (
                <li>
                  <a href={postPath(post)} aria-current={post === currentPost ? "page" : undefined}>
                    {post.title}
                  </a>
                  {post === currentPost && sections.length > 0 && (
                    <ol class="blog-nav__toc" data-blog-toc>
                      {sections.map((heading) => (
                        <li class={heading.depth === 3 ? "blog-nav__toc-sub" : undefined}>
                          <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      {
        navTags.length > 0 && (
          <section class="blog-nav__tags" aria-labelledby="blog-nav-tags">
            <p id="blog-nav-tags" class="blog-nav__group">
              Tags
            </p>
            <ul>
              {navTags.map(([tag]) => (
                <li>
                  <a class="soft-pill" href={tagPath(tag)}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
            {allTags.length > navTags.length && (
              <a class="blog-nav__more" href="/blog/tag.html">
                All {allTags.length} tags
              </a>
            )}
          </section>
        )
      }
    </nav>
    <article class="prose blog-post" data-pagefind-ignore={searchable ? undefined : ""}>
      {
        hasMeta && (
          <p class="post-meta">
            {date && <span class="post-meta__date">{dateIso ? <time datetime={dateIso}>{date}</time> : date}</span>}
            {author && <span class="post-meta__author">{authorHref ? <a href={authorHref}>{author}</a> : author}</span>}
            {series && <span class="post-meta__series">{series.title}</span>}
          </p>
        )
      }
      <h1 id={titleId}>{title}</h1>
      {subtitle && <p class="post-lede">{subtitle}</p>}
      {
        tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a class="soft-pill post-tag" href={tag.href}>
                  {tag.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class:list={["blog-post__body", { "has-lede": Boolean(subtitle) }]}>
        <slot />
      </div>
      {
        series && (
          <nav class="blog-series" aria-label={`Series: ${series.title}`} data-pagefind-ignore>
            <p class="blog-series__title">Series: {series.title}</p>
            <ol>
              {series.posts.map((entry) => (
                <li>{entry.href === series.currentHref ? <span aria-current="page">{entry.label}</span> : <a href={entry.href}>{entry.label}</a>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      {
        (previous || next) && (
          <nav class="blog-pager" aria-label="Post navigation" data-pagefind-ignore>
            {previous && (
              <a class="blog-pager__previous" rel="prev" href={previous.href}>
                <span aria-hidden="true">&larr;</span> {previous.label}
              </a>
            )}
            {next && (
              <a class="blog-pager__next" rel="next" href={next.href}>
                {next.label} <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </nav>
        )
      }
      {
        !isIndex && (
          <p class="blog-post__back" data-pagefind-ignore>
            <a href="/blog/">All posts</a>
          </p>
        )
      }
    </article>
  </div>
</Shell>

<script>
  const toc = document.querySelector<HTMLElement>("[data-blog-toc]");
  const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>("a")] : [];
  const targets = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((target): target is HTMLElement => target !== null);

  function markCurrent() {
    const offset = (document.querySelector("[data-site-header]")?.getBoundingClientRect().height ?? 0) + 72;
    let current = targets[0];
    for (const target of targets) if (target.getBoundingClientRect().top <= offset) current = target;
    for (const link of links) {
      if (current && link.hash === `#${current.id}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  }

  if (targets.length > 0) {
    markCurrent();
    window.addEventListener("scroll", markCurrent, { passive: true });
  }
</script>
