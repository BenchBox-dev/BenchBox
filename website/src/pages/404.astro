---
import Shell from "../layouts/Shell.astro";
---

<Shell title="Page Not Found - BenchBox" description="The page you requested could not be found on benchbox.dev." robots="noindex">
  <script is:inline slot="head">
    var redirectKey = 'benchbox.results.redirect';

    if (window.location.pathname.startsWith('/results/')) {
      var originalPath = window.location.pathname + window.location.search + window.location.hash;

      try {
        window.sessionStorage.setItem(redirectKey, originalPath);
      } catch (error) {}

      window.location.replace('/results/');
    }
  </script>
  <div class="prose">
    <h1>Page not found</h1>
    <p>We could not find that page. Search the docs and blog, or head back to the BenchBox home page.</p>
    <p><button type="button" data-not-found-search>Search docs and blog</button></p>
    <p><a href="/">Return to the BenchBox home page</a>.</p>
  </div>
</Shell>

<script>
  document.querySelector("[data-not-found-search]")?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>("[data-search-open]")?.click();
  });
</script>
