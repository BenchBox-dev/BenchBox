---
import Catalog from "../../components/blog/Catalog.astro";
import Blog from "../../layouts/Blog.astro";
import { yearGroups, yearPath } from "../../lib/blog.ts";
import { loadBlog } from "../../lib/blog-posts.ts";

const posts = (await loadBlog()).published;
const groups = [...yearGroups(posts)].sort((a, b) => (a[0] < b[0] ? 1 : -1));
---

<Blog title="All posts" isIndex={false} searchable={false}>
  <Catalog heading="Posted in" groups={groups} href={yearPath} />
</Blog>
