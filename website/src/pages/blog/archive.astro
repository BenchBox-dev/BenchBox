---
import { getCollection } from "astro:content";
import Catalog from "../../components/blog/Catalog.astro";
import Blog from "../../layouts/Blog.astro";
import { toPost, yearGroups, yearPath } from "../../lib/blog.ts";

const posts = (await getCollection("blog")).filter((entry) => entry.id !== "blog/index").map(toPost);
const groups = [...yearGroups(posts)].sort((a, b) => (a[0] < b[0] ? 1 : -1));
---

<Blog title="All posts" isIndex={false}>
  <Catalog heading="Posted in" groups={groups} href={yearPath} />
</Blog>
