---
import Collection from "../../../components/blog/Collection.astro";
import { slugify, tagGroups } from "../../../lib/blog.ts";
import { loadBlog } from "../../../lib/blog-posts.ts";

export async function getStaticPaths() {
  const posts = (await loadBlog()).published;
  return [...tagGroups(posts)].map(([label, tagged]) => ({ params: { tag: slugify(label) }, props: { label, tagged } }));
}

const { label, tagged } = Astro.props;
---

<Collection title={`Posts tagged ${label}`} posts={tagged} />
