---
import Collection from "../../../components/blog/Collection.astro";
import { authorGroups, slugify } from "../../../lib/blog.ts";
import { loadBlog } from "../../../lib/blog-posts.ts";

export async function getStaticPaths() {
  const posts = (await loadBlog()).published;
  return [...authorGroups(posts)].map(([name, written]) => ({ params: { author: slugify(name) }, props: { name, written } }));
}

const { name, written } = Astro.props;
---

<Collection title={`Posts by ${name}`} posts={written} />
