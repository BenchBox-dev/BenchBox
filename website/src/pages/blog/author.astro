---
import { getCollection } from "astro:content";
import Catalog from "../../components/blog/Catalog.astro";
import Blog from "../../layouts/Blog.astro";
import { authorGroups, authorPath, toPost } from "../../lib/blog.ts";

const posts = (await getCollection("blog")).filter((entry) => entry.id !== "blog/index").map(toPost);
---

<Blog title="Authors" isIndex={false}>
  <Catalog heading="Posts by" groups={[...authorGroups(posts)]} href={authorPath} />
</Blog>
