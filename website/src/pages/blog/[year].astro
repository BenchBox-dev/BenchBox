---
import Collection from "../../components/blog/Collection.astro";
import { yearGroups } from "../../lib/blog.ts";
import { loadBlog } from "../../lib/blog-posts.ts";

export async function getStaticPaths() {
  const posts = (await loadBlog()).published;
  return [...yearGroups(posts)].map(([year, published]) => ({ params: { year }, props: { year, published } }));
}

const { year, published } = Astro.props;
---

<Collection title={`Posted in ${year}`} posts={published} />
