---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection, render } from "astro:content";
import { docIndexDir } from "../../../lib/doc-index-route.ts";

export async function getStaticPaths() {
  const entries = await getCollection("docsIndex");
  return entries.map((entry) => ({ params: { dir: docIndexDir(entry.id), x: "x" }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<StarlightPage frontmatter={{ ...entry.data, editUrl: false }} headings={headings}>
  <Content />
</StarlightPage>
