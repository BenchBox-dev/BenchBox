---
import PromptComposer from "../../components/prompts/PromptComposer.tsx";
import Shell from "../../layouts/Shell.astro";
import { loadPromptCatalog } from "../../lib/prompt-catalog.ts";
import "../../../../landing/prompts/prompts.css";
import "../../styles/landing-theme.css";
import "../../styles/prompts.css";

export function getStaticPaths() {
  return [{ params: { x: "x" } }];
}

const catalog = loadPromptCatalog();
---

<Shell
  title="Instruct a coding agent to use BenchBox"
  description="Build a copy-paste prompt that tells a coding agent how to run a BenchBox benchmark. Pick a surface, platform, benchmark, and scale; copy the prompt."
>
  <div class="prompts-page">
    <div class="prompts-main">
      <header class="prompts-header">
        <h1>Instruct a coding agent to use BenchBox</h1>
        <p class="prompts-lede">
          Pick a surface, platform, benchmark, and scale. Copy the prompt into your coding agent. Defaults to a safe local DuckDB + TPC-H quickstart.
        </p>
      </header>

      <noscript>
        <div class="prompts-noscript">
          This builder is interactive and requires JavaScript. If JavaScript is disabled, here is the default quickstart:
          <code>uv add 'benchbox[duckdb]' &amp;&amp; uv run benchbox run --platform duckdb --benchmark tpch --scale 0.01</code>
        </div>
      </noscript>

      <PromptComposer client:load catalog={catalog} />
    </div>

  </div>
</Shell>
