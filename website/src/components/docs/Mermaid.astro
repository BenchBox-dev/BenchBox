---
interface Props {
  diagram: string;
}

const { diagram } = Astro.props;
---

<figure class="mermaid-figure" data-mermaid>
  <pre class="mermaid">{diagram}</pre>
</figure>

<script>
  import mermaid from "mermaid";

  const sources = new WeakMap<Element, string>();
  let counter = 0;

  function themeName(): "dark" | "default" {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "default";
  }

  async function renderAll(): Promise<void> {
    mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: themeName() });
    for (const figure of document.querySelectorAll<HTMLElement>("figure[data-mermaid]")) {
      const source = sources.get(figure) ?? figure.querySelector("pre")?.textContent ?? "";
      sources.set(figure, source);
      try {
        counter += 1;
        const { svg } = await mermaid.render(`mermaid-${counter}`, source);
        figure.innerHTML = svg;
      } catch {
        figure.innerHTML = "";
        const fallback = document.createElement("pre");
        fallback.className = "mermaid";
        fallback.textContent = source;
        figure.append(fallback);
      }
    }
  }

  void renderAll();
  new MutationObserver(() => void renderAll()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .mermaid-figure {
    margin: 1rem 0;
    overflow-x: auto;
    text-align: center;
  }

  .mermaid-figure pre {
    text-align: left;
  }
</style>
