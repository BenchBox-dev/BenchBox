---
import { shellBrand, shellCta, shellLabels, shellLinks } from "../lib/header-links.ts";
import SearchBox from "./SearchBox.astro";

interface Props {
  wrapper?: "header" | "div";
}

const { wrapper: Wrapper = "header" } = Astro.props;
const brand = shellBrand();
const links = shellLinks(Astro.url.pathname);
const cta = shellCta();
---

<Wrapper class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__logo" href={brand.href}>{brand.label}</a>
    <button
      class="site-header__toggle"
      type="button"
      aria-label={shellLabels.toggle}
      aria-controls="site-header-panel"
      aria-expanded="false"
      data-site-header-toggle
    >
      <span class="site-header__toggle-lines" aria-hidden="true"></span>
    </button>
    <div id="site-header-panel" class="site-header__panel" data-site-header-panel>
      <nav id="benchbox-site-header-nav" class="site-header__nav" aria-label={shellLabels.nav} data-site-header-nav>
        {
          links.map((link) => (
            <a
              class="site-header__link"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <a class="site-header__cta" href={cta.href}>{cta.label}</a>
      </nav>
    </div>
    <SearchBox />
  </div>
</Wrapper>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-site-header-toggle]");

  function isOpen() {
    return toggle?.getAttribute("aria-expanded") === "true";
  }

  function setOpen(open: boolean) {
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    if (header) header.dataset.open = open ? "true" : "false";
  }

  toggle?.addEventListener("click", () => setOpen(!isOpen()));
  header?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("[data-site-header-nav] a")) setOpen(false);
  });
  header?.addEventListener("focusout", (event) => {
    if (isOpen() && event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen() && !document.querySelector('dialog[open], [aria-modal="true"]')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (header && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
  });
  window.matchMedia("(min-width: 56.3125rem)").addEventListener("change", (event) => {
    if (event.matches) {
      setOpen(false);
      return;
    }
    const active = document.activeElement;
    if (active instanceof HTMLElement && active.closest("[data-site-header-panel]")) toggle?.focus();
  });
</script>
