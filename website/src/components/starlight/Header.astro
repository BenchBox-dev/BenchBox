---
import { getCollection } from "astro:content";
import { docsTrail, type TrailEntry } from "../../lib/breadcrumbs.ts";
import Breadcrumbs from "../Breadcrumbs.astro";
import SiteHeader from "../SiteHeader.astro";

const { sidebar, entry } = Astro.locals.starlightRoute;
const indexTitles = new Map(
  (await getCollection("docsIndex")).map((page) => [page.id.replace(/^docs\//, "").replace(/\/?index$/, ""), page.data.title] as const),
);
const trail = docsTrail(sidebar as TrailEntry[], entry.data.title, Astro.url.pathname, indexTitles);
const crumbs = trail.length > 0 ? trail : [{ label: "Docs" }];
---

<div class="docs-header">
  <SiteHeader wrapper="div" />
  <Breadcrumbs crumbs={crumbs} />
</div>
