---
import StarlightSidebar from "@astrojs/starlight/components/Sidebar.astro";
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";

const { toc } = Astro.locals.starlightRoute;
const hasSections = (toc?.items.length ?? 0) > 1;
---

<StarlightSidebar />
{
  hasSections && (
    <>
      <div class="sidebar-toc" data-sidebar-toc>
        <TableOfContents />
      </div>
      <script is:inline>
        (() => {
          const toc = document.currentScript.previousElementSibling;
          const current = document.querySelector('.sidebar-content a[aria-current="page"]');
          if (toc && current?.parentElement) current.parentElement.append(toc);
        })();
      </script>
    </>
  )
}
