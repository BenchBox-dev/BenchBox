---
import { SHELL_FOOTER_LEGAL, shellLabels, shellLinks } from "../lib/header-links.ts";

interface Props {
  wrapper?: "footer" | "div";
}

const { wrapper: Wrapper = "footer" } = Astro.props;
const links = shellLinks(Astro.url.pathname);
---

<Wrapper class="site-footer" data-site-footer data-pagefind-ignore>
  <div class="site-footer__inner">
    <p class="site-footer__legal">{SHELL_FOOTER_LEGAL}</p>
    <nav class="site-footer__nav" aria-label={shellLabels.footerNav}>
      {
        links.map((link) => (
          <a
            class="site-footer__link"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</Wrapper>
