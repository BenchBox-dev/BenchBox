---
import { THEME_ICON_ATTRS, THEME_ICON_SHAPES, THEME_OPTIONS, shellLabels } from "../lib/header-links.ts";

const labels = shellLabels.themeOptions;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-theme-choice="system"
  data-theme-label={shellLabels.theme}
  data-theme-labels={JSON.stringify(labels)}
  aria-label={`${shellLabels.theme}: ${labels.system}`}
>
  {
    THEME_OPTIONS.map((option) => (
      <svg {...THEME_ICON_ATTRS} class="theme-toggle__icon" data-theme-icon={option} aria-hidden="true" focusable="false">
        {THEME_ICON_SHAPES[option].map((shape) => (shape.tag === "circle" ? <circle {...shape.attrs} /> : <path {...shape.attrs} />))}
      </svg>
    ))
  }
</button>

<script>
  const KEY = "benchbox:theme";
  const CHOICES = ["system", "light", "dark"];

  function normalize(value: string | null | undefined) {
    return value && CHOICES.includes(value) ? value : "system";
  }

  function stored() {
    try {
      return normalize(localStorage.getItem(KEY));
    } catch {
      return "system";
    }
  }

  function apply(choice: string) {
    const effective = choice === "dark" || (choice === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
    const root = document.documentElement;
    root.dataset.bbThemeChoice = choice;
    root.dataset.bbTheme = effective;
    root.dataset.theme = effective;
    root.style.colorScheme = effective;
    document.body?.setAttribute("data-theme", effective);
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      const labels = JSON.parse(button.dataset.themeLabels ?? "{}") as Record<string, string>;
      const next = CHOICES[(CHOICES.indexOf(choice) + 1) % CHOICES.length];
      button.dataset.themeChoice = choice;
      button.setAttribute("aria-label", `${button.dataset.themeLabel}: ${labels[choice]}`);
      button.title = `${labels[choice]}. Switch to ${labels[next]}.`;
    });
    window.dispatchEvent(new CustomEvent("benchbox-theme-change", { detail: { choice, theme: effective } }));
  }

  function choose(choice: string) {
    try {
      if (choice === "system") localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, choice);
    } catch {}
    apply(choice);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const current = normalize(button.dataset.themeChoice);
      choose(CHOICES[(CHOICES.indexOf(current) + 1) % CHOICES.length]);
    });
  });

  apply(stored());
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (document.documentElement.dataset.bbThemeChoice === "system") apply("system");
  });
</script>
