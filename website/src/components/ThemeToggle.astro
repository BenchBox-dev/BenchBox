---
import { THEME_ICON_ATTRS, THEME_ICON_SHAPES, THEME_OPTIONS, shellLabels } from "../lib/header-links.ts";

const options = THEME_OPTIONS.map((value) => ({ value, label: shellLabels.themeOptions[value], shapes: THEME_ICON_SHAPES[value] }));
---

<div class="theme-toggle" role="radiogroup" aria-label={shellLabels.theme}>
  {
    options.map((option) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        aria-label={option.label}
        title={option.label}
        tabindex="-1"
        data-theme-option={option.value}
      >
        <svg {...THEME_ICON_ATTRS} aria-hidden="true" focusable="false">
          {option.shapes.map((shape) => (shape.tag === "circle" ? <circle {...shape.attrs} /> : <path {...shape.attrs} />))}
        </svg>
      </button>
    ))
  }
</div>

<script>
  const KEY = "benchbox:theme";
  const CHOICES = ["system", "light", "dark"];

  function normalize(value: string | null | undefined) {
    return value && CHOICES.includes(value) ? value : "system";
  }

  function stored() {
    try {
      return normalize(localStorage.getItem(KEY));
    } catch {
      return "system";
    }
  }

  function apply(choice: string) {
    const effective = choice === "dark" || (choice === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
    const root = document.documentElement;
    root.dataset.bbThemeChoice = choice;
    root.dataset.bbTheme = effective;
    root.dataset.theme = effective;
    root.style.colorScheme = effective;
    document.body?.setAttribute("data-theme", effective);
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((button) => {
      const selected = button.dataset.themeOption === choice;
      button.setAttribute("aria-checked", selected ? "true" : "false");
      button.tabIndex = selected ? 0 : -1;
    });
    window.dispatchEvent(new CustomEvent("benchbox-theme-change", { detail: { choice, theme: effective } }));
  }

  function choose(choice: string) {
    try {
      if (choice === "system") localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, choice);
    } catch {}
    apply(choice);
  }

  document.querySelectorAll<HTMLElement>(".theme-toggle").forEach((group) => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-theme-option]"));
    buttons.forEach((button) => button.addEventListener("click", () => choose(button.dataset.themeOption ?? "system")));
    group.addEventListener("keydown", (event) => {
      const index = buttons.indexOf(document.activeElement as HTMLButtonElement);
      if (index < 0) return;
      let next: number;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % buttons.length;
      else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + buttons.length) % buttons.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = buttons.length - 1;
      else if (event.key === " " || event.key === "Enter") next = index;
      else return;
      event.preventDefault();
      choose(buttons[next].dataset.themeOption ?? "system");
      buttons[next].focus();
    });
  });

  apply(stored());
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (document.documentElement.dataset.bbThemeChoice === "system") apply("system");
  });
</script>
