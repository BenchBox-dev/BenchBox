---
---

<button type="button" class="search-button" data-search-open aria-haspopup="dialog" aria-label="Search">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="7" />
    <path d="m20 20-3.5-3.5" />
  </svg>
  <span class="search-button__label">Search</span>
</button>
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
  <div class="search-dialog__bar">
    <h2 id="search-dialog-title">Search docs and blog</h2>
    <form method="dialog"><button class="search-close" aria-label="Close search">Close</button></form>
  </div>
  <div data-search-mount></div>
  <section class="search-section" data-search-section="results" aria-labelledby="search-results-title" hidden>
    <h3 id="search-results-title">Results</h3>
    <ul data-search-results></ul>
  </section>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const opener = document.querySelector<HTMLButtonElement>("[data-search-open]");
  let ready: Promise<void> | undefined;

  function load(): Promise<void> {
    ready ??= new Promise((resolve, reject) => {
      const styles = document.createElement("link");
      styles.rel = "stylesheet";
      styles.href = "/pagefind/pagefind-ui.css";
      document.head.append(styles);
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        const mount = dialog?.querySelector("[data-search-mount]");
        const Ui = (window as unknown as { PagefindUI: new (options: object) => unknown }).PagefindUI;
        new Ui({ element: mount, showSubResults: true, showImages: false });
        resolve();
      };
      script.onerror = () => reject(new Error("pagefind unavailable"));
      document.head.append(script);
    });
    return ready;
  }

  function open() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    load()
      .then(() => dialog.querySelector<HTMLInputElement>("input")?.focus())
      .catch(() => {
        ready = undefined;
      });
  }

  opener?.addEventListener("click", open);
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      open();
    }
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
