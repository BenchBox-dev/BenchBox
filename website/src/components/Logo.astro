---
import { logoGrid } from "../lib/header-links.ts";

interface Props {
  class?: string;
  label?: string;
}

const { class: className, label } = Astro.props;
const { width, height, cells } = logoGrid();
---

<svg
  class:list={["logo", className]}
  viewBox={`0 0 ${width} ${height}`}
  shape-rendering="crispEdges"
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {cells.map((cell) => <rect x={cell.x} y={cell.y} width={cell.width} height="1" />)}
</svg>
