---
import type { CardGroup } from "../../lib/landing-data.ts";

interface Props {
  group: CardGroup;
  compact?: boolean;
}

const { group, compact = false } = Astro.props;
---

<div class:list={["catalog", { "catalog--compact": compact }]}>
  <div class="catalog__head">
    <h3 class="catalog__title">{group.title}</h3>
    <p class="catalog__subtitle">{group.subtitle}</p>
  </div>
  <ul class="catalog__list">
    {
      group.cards.map((card) => (
        <li class="catalog__item">
          <a class="catalog__link" href={card.href}>
            <span class="catalog__name">{card.title}</span>
            <span class="catalog__meta">{card.meta}</span>
          </a>
          <p class="catalog__desc">{card.description}</p>
          {card.origin && (
            <a class="catalog__origin" href={card.origin.href} target="_blank" rel="noopener">
              {card.origin.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
