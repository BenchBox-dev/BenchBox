---
import Blog from "../../layouts/Blog.astro";
import type { BlogPost } from "../../lib/blog.ts";
import PostList from "./PostList.astro";

interface Props {
  title: string;
  posts: BlogPost[];
  emptyText?: string;
}

const { title, posts, emptyText } = Astro.props;
---

<Blog title={title} isIndex={false} searchable={false}>
  {posts.length > 0 ? <PostList posts={posts} /> : emptyText && <p>{emptyText}</p>}
</Blog>
