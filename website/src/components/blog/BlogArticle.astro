---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Shell from "../../layouts/Shell.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Shell title={`${post.data.title} - BenchBox Blog`} description={post.data.description} searchable>
  <article class="prose">
    <h1 id={post.data.titleId}>{post.data.title}</h1>
    <p class="post-meta">{post.data.author} · {post.data.date}</p>
    <Content />
  </article>
</Shell>
