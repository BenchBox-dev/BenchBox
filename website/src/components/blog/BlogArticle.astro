---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Blog from "../../layouts/Blog.astro";
import { AUTHORS, authorPath, formatBlogDate, neighbours, postPath, seriesOf, seriesTitle, tagPath, toPost } from "../../lib/blog.ts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const isIndex = post.id === "blog/index";
const entry = isIndex || post.data.date === undefined ? undefined : toPost(post);
const posts = entry ? (await getCollection("blog")).filter((candidate) => candidate.id !== "blog/index").map(toPost) : [];
const { previous, next } = entry ? neighbours(posts, entry) : {};
const siblings = entry ? seriesOf(posts, entry) : [];
const link = (target: typeof previous) => (target ? { label: target.title, href: postPath(target) } : undefined);
---

<Blog
  title={post.data.title}
  titleId={post.data.titleId}
  description={post.data.description}
  author={entry?.author ?? post.data.author}
  authorHref={entry && entry.author in AUTHORS ? authorPath(entry.author) : undefined}
  date={entry ? formatBlogDate(entry.date) : post.data.date}
  tags={entry?.tags.map((tag) => ({ label: tag, href: tagPath(tag) })) ?? []}
  series={entry?.series && siblings.length > 1
    ? { title: seriesTitle(entry.series), currentHref: postPath(entry), posts: siblings.map((sibling) => ({ label: sibling.title, href: postPath(sibling) })) }
    : undefined}
  previous={link(previous)}
  next={link(next)}
  isIndex={isIndex}
>
  <Content />
</Blog>
