---
import { formatBlogDate, postPath, type BlogPost } from "../../lib/blog.ts";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.date.toISOString().slice(0, 10)}>{formatBlogDate(post.date)}</time>
        {" - "}
        <a href={postPath(post)}>{post.title}</a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding-left: 0;
  }
  .post-list li {
    margin: 0.5rem 0;
  }
</style>
