---
import type { BlogPost } from "../../lib/blog.ts";
import PostList from "./PostList.astro";

interface Props {
  heading: string;
  groups: [string, BlogPost[]][];
  href: (key: string) => string;
}

const { heading, groups, href } = Astro.props;
---

{
  groups.map(([key, posts]) => (
    <section>
      <h2>
        {heading} <a href={href(key)}>{key}</a>
      </h2>
      <PostList posts={posts} />
    </section>
  ))
}
