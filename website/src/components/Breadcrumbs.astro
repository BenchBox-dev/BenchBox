---
import type { Crumb } from "../lib/breadcrumbs.ts";

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{
  crumbs.length > 0 && (
    <nav class="context-bar breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      <ol class="context-bar__inner">
        {crumbs.map((crumb, position) => (
          <li>
            {crumb.href && position < crumbs.length - 1 ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span aria-current={position === crumbs.length - 1 ? "page" : undefined}>{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
      <script is:inline>
        (() => {
          const list = document.currentScript.previousElementSibling;
          const crumbs = [...list.children];
          let ellipsis;
          let expanded = false;

          function reset() {
            ellipsis?.remove();
            ellipsis = undefined;
            for (const crumb of crumbs) crumb.hidden = false;
          }

          function fit() {
            reset();
            if (expanded || crumbs.length < 3 || list.scrollWidth <= list.clientWidth) return;
            ellipsis = document.createElement("li");
            ellipsis.className = "context-bar__ellipsis";
            const button = document.createElement("button");
            button.type = "button";
            button.textContent = "…";
            button.setAttribute("aria-label", "Show the full path");
            button.addEventListener("click", () => {
              expanded = true;
              reset();
              const target = crumbs.slice(1).map((crumb) => crumb.querySelector("a")).find(Boolean) ?? list;
              if (target === list) list.tabIndex = -1;
              target.focus({ preventScroll: true });
              list.scrollLeft = list.scrollWidth;
            });
            ellipsis.append(button);
            crumbs[0].after(ellipsis);
            for (const crumb of crumbs.slice(1, -1)) {
              if (list.scrollWidth <= list.clientWidth) break;
              crumb.hidden = true;
            }
            list.scrollLeft = list.scrollWidth;
          }

          fit();
          let frame = 0;
          window.addEventListener("resize", () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(fit);
          });
        })();
      </script>
    </nav>
  )
}
