## summary_counts
SQL:
SELECT
          (SELECT COUNT(*) FROM results) AS public_result_bundles,
          (SELECT COUNT(DISTINCT benchmark) FROM results) AS benchmarks_with_public_results,
          (SELECT COUNT(DISTINCT benchmark || ':' || scale_factor || ':' || COALESCE(test_type, 'power')) FROM results) AS public_result_cohorts,
          (SELECT COUNT(DISTINCT benchmark) FROM benchmark_rankings WHERE cohort_ranked_count >= 2) AS benchmarks_with_rankable_cohorts,
          (SELECT COUNT(DISTINCT cohort_key) FROM cohort_metadata WHERE platform_count >= 2) AS cross_benchmark_leaderboard_cohorts,
          (SELECT COUNT(DISTINCT platform_id) FROM results) AS platforms_with_public_results,
          (SELECT COUNT(*) FROM meta_leaderboard) AS platforms_in_ranked_meta_leaderboard,
          (SELECT COUNT(DISTINCT platform_id) FROM cohort_metadata WHERE platform_count >= 2) AS platforms_with_visible_leaderboard_evidence
OUTPUT:
public_result_bundles	benchmarks_with_public_results	public_result_cohorts	benchmarks_with_rankable_cohorts	cross_benchmark_leaderboard_cohorts	platforms_with_public_results	platforms_in_ranked_meta_leaderboard	platforms_with_visible_leaderboard_evidence
11	2	3	1	1	7	5	7

## benchmark_scope
SQL:
WITH public_benchmarks AS (
          SELECT benchmark, COUNT(*) AS result_count
          FROM results
          GROUP BY benchmark
        ),
        leaderboard_benchmarks AS (
          SELECT benchmark, COUNT(DISTINCT cohort_key) AS leaderboard_cohorts
          FROM cohort_metadata
          WHERE platform_count >= 2
          GROUP BY benchmark
        )
        SELECT
          p.benchmark,
          p.result_count,
          COALESCE(l.leaderboard_cohorts, 0) AS leaderboard_cohorts,
          CASE WHEN COALESCE(l.leaderboard_cohorts, 0) > 0 THEN 'selectable' ELSE 'public_result_not_leaderboard_eligible' END AS filter_state
        FROM public_benchmarks p
        LEFT JOIN leaderboard_benchmarks l USING (benchmark)
        ORDER BY p.benchmark
OUTPUT:
benchmark	result_count	leaderboard_cohorts	filter_state
star_schema	1	0	public_result_not_leaderboard_eligible
tpch	10	1	selectable

## platform_scope
SQL:
WITH public_platforms AS (
          SELECT platform_id, ANY_VALUE(platform) AS platform, COUNT(*) AS result_count
          FROM results
          GROUP BY platform_id
        ),
        leaderboard_evidence AS (
          SELECT platform_id, COUNT(DISTINCT cohort_key) AS visible_evidence_cohorts
          FROM cohort_metadata
          WHERE platform_count >= 2
          GROUP BY platform_id
        ),
        ranked AS (
          SELECT platform_id, n_cohorts AS ranked_cohorts
          FROM meta_leaderboard
        )
        SELECT
          p.platform_id,
          p.platform,
          p.result_count,
          COALESCE(e.visible_evidence_cohorts, 0) AS visible_evidence_cohorts,
          COALESCE(r.ranked_cohorts, 0) AS ranked_cohorts,
          CASE
            WHEN COALESCE(r.ranked_cohorts, 0) > 0 THEN 'ranked_visible'
            WHEN COALESCE(e.visible_evidence_cohorts, 0) > 0 THEN 'published_visible_unranked'
            ELSE 'public_result_outside_leaderboard_scope'
          END AS table_state
        FROM public_platforms p
        LEFT JOIN leaderboard_evidence e USING (platform_id)
        LEFT JOIN ranked r USING (platform_id)
        ORDER BY table_state, p.platform_id
