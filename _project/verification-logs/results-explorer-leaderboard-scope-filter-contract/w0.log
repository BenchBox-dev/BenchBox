## tuning_mode_counts
SQL:
SELECT
          CASE
            WHEN tuning_mode IS NULL THEN '<null>'
            WHEN trim(tuning_mode) = '' THEN '<empty>'
            ELSE tuning_mode
          END AS tuning_mode_state,
          COUNT(*) AS result_count,
          COUNT(DISTINCT platform_id) AS platform_count,
          COUNT(DISTINCT benchmark) AS benchmark_count
        FROM results
        GROUP BY 1
        ORDER BY tuning_mode_state
OUTPUT:
tuning_mode_state	result_count	platform_count	benchmark_count
<null>	10	7	2
tuned	1	1	1

## leaderboard_tuning_scope
SQL:
SELECT
          CASE
            WHEN r.tuning_mode IS NULL THEN '<null>'
            WHEN trim(r.tuning_mode) = '' THEN '<empty>'
            ELSE r.tuning_mode
          END AS tuning_mode_state,
          COUNT(*) AS visible_leaderboard_rows,
          COUNT(DISTINCT c.platform_id) AS visible_platforms,
          COUNT(DISTINCT c.cohort_key) AS visible_cohorts
        FROM cohort_metadata c
        JOIN results r USING (result_id)
        WHERE c.platform_count >= 2
        GROUP BY 1
        ORDER BY tuning_mode_state
OUTPUT:
