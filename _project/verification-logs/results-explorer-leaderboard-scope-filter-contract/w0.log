## cohort_scope
SQL:
SELECT
          benchmark,
          scale_factor,
          phase,
          cohort_key,
          platform_count,
          cohort_ranked_count,
          cohort_ranking_exclusion_reason,
          primary_metric,
          primary_order
        FROM cohort_metadata
        WHERE platform_count >= 2
        GROUP BY ALL
        ORDER BY benchmark, scale_factor, phase
