-- state_counts
WITH leaderboard_cohorts AS (
            SELECT DISTINCT cohort_key
            FROM cohort_metadata
            WHERE platform_count >= 2
        ),
        leaderboard_platforms AS (
            SELECT platform_id
            FROM meta_leaderboard
        ),
        existing AS (
            SELECT DISTINCT cohort_key, platform_id
            FROM cohort_metadata
            WHERE cohort_key IN (SELECT cohort_key FROM leaderboard_cohorts)
        ),
        true_missing AS (
            SELECT c.cohort_key, p.platform_id
            FROM leaderboard_cohorts c
            CROSS JOIN leaderboard_platforms p
            LEFT JOIN existing e USING (cohort_key, platform_id)
            WHERE e.platform_id IS NULL
        ),
        published_unranked AS (
            SELECT cohort_key, platform_id, result_id, metric_value, ranking_exclusion_reason, cohort_ranking_exclusion_reason
            FROM cohort_metadata
            WHERE platform_count >= 2 AND rank IS NULL
        ),
        ranked AS (
            SELECT cohort_key, platform_id, result_id, rank
            FROM cohort_metadata
            WHERE platform_count >= 2 AND rank IS NOT NULL
        )
        SELECT 'true_missing' AS state, COUNT(*) AS rows FROM true_missing
        UNION ALL
        SELECT 'published_unranked_metric', COUNT(*) FROM published_unranked WHERE metric_value IS NOT NULL
        UNION ALL
        SELECT 'published_unranked_no_metric', COUNT(*) FROM published_unranked WHERE metric_value IS NULL
        UNION ALL
        SELECT 'ranked', COUNT(*) FROM ranked
        ORDER BY state
