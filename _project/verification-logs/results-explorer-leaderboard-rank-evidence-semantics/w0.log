-- unranked_reason_counts
SELECT
            COALESCE(ranking_exclusion_reason, cohort_ranking_exclusion_reason, 'missing_reason') AS reason,
            COUNT(*) AS rows
        FROM cohort_metadata
        WHERE platform_count >= 2 AND rank IS NULL
        GROUP BY 1
        ORDER BY rows DESC, reason
