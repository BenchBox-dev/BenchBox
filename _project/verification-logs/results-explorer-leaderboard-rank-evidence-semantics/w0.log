-- sample_published_unranked_with_badge_sources
SELECT
            cm.cohort_key,
            cm.platform_id,
            cm.result_id,
            cm.rank,
            cm.metric_value,
            cm.ranking_exclusion_reason,
            cm.cohort_ranking_exclusion_reason,
            cm.trust_label,
            r.validation_status
        FROM cohort_metadata cm
        JOIN results r USING (result_id)
        WHERE cm.platform_count >= 2
          AND cm.rank IS NULL
        ORDER BY cm.cohort_key, cm.platform_id, cm.result_id
        LIMIT 20
