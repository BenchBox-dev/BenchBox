-- rank_chart_all_unrankable_cohorts
SELECT benchmark, scale_factor, phase, COUNT(*) AS rows, MAX(cohort_ranking_exclusion_reason) AS cohort_reason
        FROM benchmark_rankings
        GROUP BY benchmark, scale_factor, phase
        HAVING SUM(CASE WHEN rank IS NOT NULL THEN 1 ELSE 0 END) = 0
        ORDER BY benchmark, scale_factor, phase
