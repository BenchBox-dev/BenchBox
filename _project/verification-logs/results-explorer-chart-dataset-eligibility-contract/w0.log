SQL: benchmark summary source tables and per-cell validity
SELECT br.benchmark, br.scale_factor, br.phase,
       COUNT(DISTINCT br.result_id) AS ranking_rows,
       COUNT(DISTINCT bmc.result_id) AS matrix_results,
       COUNT(*) FILTER (WHERE bmc.display_ms IS NOT NULL) AS matrix_cells_with_display_ms,
       COUNT(*) FILTER (WHERE bmc.is_valid_display_timing) AS valid_display_cells,
       COUNT(*) FILTER (WHERE NOT bmc.is_valid_display_timing) AS excluded_display_cells
FROM benchmark_rankings br
LEFT JOIN benchmark_matrix_cells bmc USING (benchmark, scale_factor, phase, result_id)
GROUP BY 1,2,3
ORDER BY 1,2,3;

