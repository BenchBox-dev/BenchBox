SQL: sample row exclusions
SELECT result_id, benchmark, scale_factor, COALESCE(test_type, 'power') AS phase,
       platform_id, display_exclusion_reason, ranking_exclusion_reason,
       comparison_exclusion_reason, has_display_timing, valid_query_count,
       missing_query_count, zero_timing_count, display_geomean_ms, power_score
FROM results
WHERE display_exclusion_reason IS NOT NULL
   OR ranking_exclusion_reason IS NOT NULL
   OR comparison_exclusion_reason IS NOT NULL
ORDER BY benchmark, scale_factor, platform_id, result_id
LIMIT 20;

