SQL used:
  SELECT benchmark, scale_factor, phase, primary_metric,
         count(*) AS rows,
         count(*) FILTER (WHERE comparison_exclusion_reason IS NULL) AS comparable,
         string_agg(result_id || '|' || platform || '|' || short_id, ', ' ORDER BY platform, result_id) AS ids
  FROM benchmark_rankings
  GROUP BY 1,2,3,4
  HAVING comparable >= 2
  ORDER BY benchmark, scale_factor, phase, primary_metric;

  SELECT p.platform_id, p.benchmark, p.scale_factor, coalesce(r.test_type, 'power') AS phase,
         count(*) AS rows,
         count(*) FILTER (WHERE p.comparison_exclusion_reason IS NULL) AS comparable,
         string_agg(p.result_id || '|' || p.platform || '|' || coalesce(s.short_id, ''), ', ' ORDER BY p.benchmark, p.platform, p.result_id) AS ids
  FROM platform_index_rows p
  LEFT JOIN results r USING (result_id)
  LEFT JOIN short_ids s USING (result_id)
  GROUP BY 1,2,3,4
  HAVING comparable >= 2
  ORDER BY p.platform_id, p.benchmark, p.scale_factor, phase;

  SELECT r.benchmark, r.scale_factor, coalesce(r.test_type, 'power') AS phase,
         count(*) AS rows,
         count(*) FILTER (WHERE r.comparison_exclusion_reason IS NULL) AS comparable,
         string_agg(r.result_id || '|' || r.platform || '|' || coalesce(s.short_id, ''), ', ' ORDER BY r.platform, r.result_id) AS ids
  FROM results r
  LEFT JOIN short_ids s USING (result_id)
  GROUP BY 1,2,3
  HAVING comparable >= 2
  ORDER BY r.benchmark, r.scale_factor, phase;

