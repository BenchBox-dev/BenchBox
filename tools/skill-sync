set -eu

PROG=skill-sync
VERSION=1.0.0
RECEIPT=skill-sync.receipt
MANIFEST=skill-sync.manifest
RSYNC=${SKILL_SYNC_RSYNC:-rsync}
SHA=

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_err() { printf '%s: %s\n\n' "$PROG" "$*" >&2; usage >&2; exit 2; }

usage() {
	cat <<'USAGE'
skill-sync — copy selected skill packages from Git catalogs into a project.

Usage:
  skill-sync preview [-C DIR] [-f CONFIG]   Show what apply would change (read-only)
  skill-sync check   [-C DIR] [-f CONFIG]   Like preview, but exit 3 if changes are pending
  skill-sync apply   [-C DIR] [-f CONFIG]   Copy the payload into the project
