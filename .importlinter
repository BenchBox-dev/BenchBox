; Import-linter configuration for BenchBox.
;
; Encodes the layering convention described in the architecture review
; (utils < core < platforms < cli), plus isolation contracts for
; benchbox.experimental and benchbox.mcp. See
; _project/TODO/main/planning/import-layering-enforcement.yaml for the
; rationale and the ratchet-down plan for the allowlisted exceptions below.
;
; Every ignore_imports entry below is a REAL violation found by running
; `uv run -- lint-imports` on this branch (2026-07-04), not a guess. Do not
; add new entries here to silence a newly introduced violation - fix the
; import instead. Ratchet the list down as violations are resolved.

[importlinter]
root_package = benchbox

[importlinter:contract:layers]
name = Layered architecture: utils < core < platforms < cli
type = layers
layers =
    benchbox.cli
    benchbox.platforms
    benchbox.core
    benchbox.utils
ignore_imports =
    ; --- utils -> core -------------------------------------------------
    ; benchbox.utils.{dependencies,tpc_compilation,verbosity} lazily
    ; `import benchbox` (root) inside functions as a fallback/introspection
    ; path. Because benchbox/__init__.py re-exports benchmark modules that
    ; pull in benchbox.core (and benchbox.platforms), severing this edge at
    ; the root-import hop kills the whole indirect chain in one line per
    ; offending file instead of allowlisting every downstream target.
    benchbox.utils.dependencies -> benchbox
    benchbox.utils.tpc_compilation -> benchbox
    benchbox.utils.verbosity -> benchbox
    ; benchbox.utils.path_utils needs the resolved runtime data/cache dirs
    ; that benchbox.core.runtime_paths computes - genuine existing coupling,
    ; not fixed by this TODO (detection only, see must_preserve).
    benchbox.utils.path_utils -> benchbox.core.runtime_paths
    ; --- utils -> cli ----------------------------------------------------
    ; benchbox.utils.config_interface lazily imports benchbox.cli.config to
    ; reuse the CLI's config manager - pre-existing coupling.
    benchbox.utils.config_interface -> benchbox.cli.config
    ; --- utils -> platforms ----------------------------------------------
    ; benchbox.utils.format_selection needs platform format-capability
    ; metadata to pick a default output format - pre-existing coupling.
    benchbox.utils.format_selection -> benchbox.platforms.base.format_capabilities
    ; --- core -> platforms (indirect, via `import benchbox` root fallback)
    ; Same root-import-hop pattern as the utils entries above: these core
    ; modules lazily `import benchbox`, which chains to benchbox.platforms
    ; via benchbox/__init__.py. Severing at the root-import hop avoids
    ; enumerating every platform submodule reachable through it.
    benchbox.core.benchmark_registry -> benchbox
    benchbox.core.dryrun -> benchbox
    benchbox.core.expected_results.loader -> benchbox
    benchbox.core.tpcds.c_tools -> benchbox
    benchbox.core.tpcds.generator.manager -> benchbox
    benchbox.core.tpch.generator -> benchbox
    benchbox.core.tpch.queries -> benchbox
    benchbox.core.tpchavoc.equivalence -> benchbox
    ; --- core -> platforms (direct) ---------------------------------------
    ; core's platform-registry/factory/dispatch/equivalence-comparison
    ; pattern needs concrete access to platform adapter classes - this is
    ; the existing architecture (registry pattern), not something
    ; break-root-import-cycle or relocate-cli-hook-registries touched, and
    ; out of scope for this detection-only TODO (see must_preserve).
    benchbox.core.comparison.suite -> benchbox.platforms
    benchbox.core.config_utils -> benchbox.platforms.clickhouse.deployment_mode
    benchbox.core.dataframe.benchmark_suite -> benchbox.platforms
    benchbox.core.dataframe.data_loader -> benchbox.platforms.base.data_loading
    benchbox.core.dataframe.maintenance_interface -> benchbox.platforms.dataframe.delta_lake_maintenance
    benchbox.core.dataframe.maintenance_interface -> benchbox.platforms.dataframe.ducklake_maintenance
    benchbox.core.dataframe.maintenance_interface -> benchbox.platforms.dataframe.iceberg_maintenance
    benchbox.core.dataframe.maintenance_interface -> benchbox.platforms.dataframe.polars_maintenance
    benchbox.core.dryrun -> benchbox.platforms
    benchbox.core.dryrun -> benchbox.platforms.adapter_factory
    benchbox.core.dryrun -> benchbox.platforms.dataframe.platform_checker
    benchbox.core.dryrun -> benchbox.platforms.duckdb
    benchbox.core.equivalence.builders.base -> benchbox.platforms.duckdb
    benchbox.core.equivalence.dataframe_surface -> benchbox.platforms.dataframe.pandas_df
    benchbox.core.equivalence.dataframe_surface -> benchbox.platforms.dataframe.polars_df
    benchbox.core.manifest.preferences -> benchbox.platforms.base.format_capabilities
    benchbox.core.platform_registry -> benchbox.platforms.base
    benchbox.core.runner.dataframe_runner -> benchbox.platforms.adapter_factory
    benchbox.core.runner.runner -> benchbox.platforms
    benchbox.core.runner.runner -> benchbox.platforms.base.format_capabilities
    benchbox.core.runner.runner -> benchbox.platforms.base.runtime_metadata
    benchbox.core.runner.runner -> benchbox.platforms.dataframe.benchmark_mixin
    benchbox.core.tpcds.dataframe_queries.rollup_helper -> benchbox.platforms.dataframe.unified_frame
    benchbox.core.tpcds.dataframe_queries.rollup_helper -> benchbox.platforms.dataframe.unified_pandas_frame
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.clickhouse.query_transformer
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.clickhouse_local
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.datafusion
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.datafusion_query_transformer
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.duckdb
    benchbox.core.tpchavoc.equivalence -> benchbox.platforms.postgresql
    benchbox.core.transaction_primitives.dataframe_operations -> benchbox.platforms.dataframe.pyspark_maintenance
    benchbox.core.write_primitives.benchmark -> benchbox.platforms.base.data_loading
    benchbox.core.write_primitives.benchmark -> benchbox.platforms.duckdb
    benchbox.core.write_primitives.dataframe_operations -> benchbox.platforms.dataframe.pyspark_maintenance

; NOTE: this started as a `type = independence` contract per the TODO's
; literal wording, but independence checks ALL listed modules for mutual
; imports in EITHER direction - running it showed that immediately breaks
; on the legitimate cli->core, platforms->core, core->utils, etc. edges
; that the layers contract above explicitly allows, since core/platforms/
; cli/utils are not actually independent of each other, only of
; experimental. `forbidden` (source_modules must not import
; forbidden_modules) is the correct one-directional tool here, matching
; the mcp contract below.
[importlinter:contract:experimental-isolated]
name = benchbox.experimental is not imported by core/platforms/cli/utils
type = forbidden
source_modules =
    benchbox.core
    benchbox.platforms
    benchbox.cli
    benchbox.utils
forbidden_modules =
    benchbox.experimental
ignore_imports =
    ; Known, tracked violation: benchbox/platforms/cudf.py imports
    ; benchbox.experimental.gpu at module top level. Owned by
    ; remove-or-integrate-legacy-cudf-platform-module.yaml (decides
    ; removal/quarantine/integration) - do not duplicate that decision
    ; here, just allowlist until it resolves.
    benchbox.platforms.cudf -> benchbox.experimental.gpu

; benchbox.mcp is a one-directional consumer of core/utils (it exposes
; benchmark data and execution via MCP tools - see
; benchbox/mcp/tools/*.py), so "independence" (which forbids imports in
; either direction) is the wrong tool here: it would require re-allowlisting
; every core/utils symbol mcp's tool modules touch, defeating the point of
; the contract. A "forbidden" contract instead enforces the direction that
; actually matters - core/platforms/cli/utils must never import mcp - while
; leaving mcp's established, intentional dependency on core/utils alone.
; See the TODO's open_questions entry, which anticipated exactly this case.
[importlinter:contract:mcp-not-imported-by-core]
name = benchbox.mcp is not imported by core/platforms/cli/utils
type = forbidden
source_modules =
    benchbox.core
    benchbox.platforms
    benchbox.cli
    benchbox.utils
forbidden_modules =
    benchbox.mcp
